{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "dev": "cross-env NODE_ENV=development nodemon --watch . --ext ts --exec \"tsx index.ts\"",
    "prod": "cross-env NODE_ENV=production tsx index.ts",
    "start": "cross-env NODE_ENV=production tsx index.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "typeorm": "^1.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
